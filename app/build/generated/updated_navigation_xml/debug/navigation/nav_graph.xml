<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/nav_graph"
app:startDestination="@id/profileFragment" >
<fragment
    android:id="@+id/profileFragment"
    android:name="com.breadcrumbs.ui.ProfileFragment"
    android:label="Profile"
    tools:layout="@layout/fragment_profile" >

    <action
        android:id="@+id/action_profile_to_createTrip"
        app:destination="@id/createTripFragment" />
    <action
        android:id="@+id/action_profile_to_tripDetail"
        app:destination="@id/tripDetailFragment" />

</fragment>
<fragment
    android:id="@+id/createTripFragment"
    android:name="com.breadcrumbs.ui.CreateTripFragment"
    android:label="Create Trip"
    tools:layout="@layout/fragment_create_trip" />
<fragment
    android:id="@+id/tripDetailFragment"
    android:name="com.breadcrumbs.ui.TripDetailFragment"
    android:label="Trip Detail"
    tools:layout="@layout/fragment_trip_detail" >

    <argument
        android:name="tripId"
        app:argType="string" />

    <action
        android:id="@+id/action_tripDetail_to_addPoi"
        app:destination="@id/addPoiFragment" />

</fragment>
<fragment
    android:id="@+id/addPoiFragment"
    android:name="com.breadcrumbs.ui.AddPoiFragment"
    android:label="Add POI"
    tools:layout="@layout/fragment_add_poi" >

    <argument
        android:name="tripId"
        app:argType="string" />

</fragment>
</navigation>